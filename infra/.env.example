# ===== PostgreSQL =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=auditoria
POSTGRES_PORT=5432

# ===== Backend (FastAPI) =====
DEBUG=true
# host do postgres VISTO de dentro da rede docker (porta = POSTGRES_PORT acima)
POSTGRES_HOST=postgres

# ===== Nginx / Web app =====
NGINX_PORT=80
BACKEND_URL=http://backend:8000

# ===== Keycloak =====
# Porta pública do Keycloak no host (browser usa http://localhost:<porta>).
KEYCLOAK_PORT=8080
# Admin bootstrap (KC_BOOTSTRAP_ADMIN_*); trocar em produção.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Banco dedicado do Keycloak (serviço keycloak-db, sem porta no host).
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_DB=keycloak
# URL interna (rede docker) usada pelo nginx e pelo JWKS do backend.
KEYCLOAK_URL=http://keycloak:8080
# Hostname/issuer público embutido nos tokens. Fonte única do host público:
# dele derivam KEYCLOAK_ISSUER (backend) e NEXT_PUBLIC_KEYCLOAK_URL (frontend).
KEYCLOAK_HOSTNAME=http://localhost:8080

# ===== Frontend (Next.js) — build args inlined no build =====
# Default derivado de KEYCLOAK_HOSTNAME; só defina se o browser usar outro host.
#NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=auditoria
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=auditoria-frontend
